# Docker Compose local configuration template.
# Copy this file to .env and replace placeholders with local values.

DATABASE_URL=mysql+pymysql://用户名:数据库密码@127.0.0.1:3306/huiguan_yunkong?charset=utf8mb4
SHUIFEI_DB=mysql://用户名:数据库密码@127.0.0.1:3306/huiguan_yunkong
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=用户名
MYSQL_PASSWORD=数据库密码
MYSQL_DB=huiguan_yunkong
ECS_IP=127.0.0.1
OBS_BUCKET=本地演示不使用
SKIP_DB_INIT=false

# AI_API_KEY is consumed by the backend service. Keep the real key in a
# local untracked .env or CodeArts secret variable, never in this archive.
AI_API_KEY=your-api-key-here
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL_NAME=deepseek-chat
AI_TIMEOUT=30
AI_RATE_LIMIT=10
