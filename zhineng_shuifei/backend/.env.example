# 慧灌云控 AI辅助分析环境变量配置
# 复制本文件为.env并填写实际值，或直接设置系统环境变量
# API密钥不出现在前端/源代码/日志中

# AI模型API密钥（必填，未设置时自动降级为规则算法）
AI_API_KEY=your-api-key-here

# AI模型接口地址（默认DeepSeek官方地址，兼容OpenAI API格式）
AI_API_URL=https://api.deepseek.com/v1/chat/completions

# AI模型名称（默认deepseek-chat）
AI_MODEL_NAME=deepseek-chat

# AI请求超时秒数（默认30）
AI_TIMEOUT=30

# AI调用频率限制：每分钟最大调用次数（默认10）
AI_RATE_LIMIT=10

# 数据库连接URL（MySQL模式）
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 密码中的@需URL编码为%40
# DATABASE_URL=mysql://root:Huiguan%402026@127.0.0.1:3306/huiguan_yunkong

# 后端服务端口（默认5050）
PORT=5050

# Flask调试模式（生产环境设为0）
FLASK_DEBUG=0